# Copie este arquivo para .env e ajuste os valores antes de rodar em produção.

# String de conexão com o Postgres
DATABASE_URL=postgresql+psycopg://bigpost:bigpost@localhost:5432/bigpost

# Chave usada para assinar os tokens JWT de sessão (gere uma nova em produção: openssl rand -hex 32)
JWT_SECRET=troque-esta-chave-em-producao
JWT_EXPIRE_MINUTES=480

# Usuário Master criado automaticamente na primeira execução, caso ainda não exista nenhum usuário
BOOTSTRAP_MASTER_USERNAME=Fifo
BOOTSTRAP_MASTER_PASSWORD=troque-esta-senha

# Diretório onde ficam as chaves de assinatura de licença (Ed25519) e o estado do app
DATA_DIR=./data

# Segredo compartilhado para o Painel Master (sistema externo, cadastra e licencia
# agências) chamar a API de integração deste BigPost. Gere um valor aleatório
# (ex.: openssl rand -hex 32) e configure o MESMO valor no Painel Master, no
# cabeçalho X-API-Key. Deixe em branco para manter a integração desligada.
PAINEL_MASTER_API_KEY=
